<?xml version="1.0" encoding="UTF-8"?>
<!--
  企业绿色评级系统 · IIS 配置
  作用：为 React SPA 的 pathname 路由提供 fallback（/financial-supermarket、/certificate-query 等刷新不报 404）
  依赖：IIS URL Rewrite 模块（IIS 10 默认已装；若 500 错误请先安装：https://www.iis.net/downloads/microsoft/url-rewrite）
  规则：
    1. 真实静态资源（assets/、join-us/）直接放行
    2. 已知文件后缀（js/css/png/...）直接放行
    3. 其它请求（既不是文件也不是目录）→ rewrite 到 index.html，由 React Router 接管
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <clear />
        <rule name="Static Assets Dir" stopProcessing="true">
          <match url="^(assets|join-us)/.*$" />
          <action type="None" />
        </rule>
        <rule name="Known File Extensions" stopProcessing="true">
          <match url="^.*\.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|otf|eot|json|map|txt|xml|html|webp|avif)$" />
          <action type="None" />
        </rule>
        <rule name="SPA Fallback" stopProcessing="true">
          <match url="^.*$" />
          <conditions logicalGrouping="MatchAll">
            <!-- 仅 GET 方法做 fallback，避免 POST/PUT/DELETE 被错误地 rewrite 到 index.html（会触发 405 Method Not Allowed） -->
            <add input="{REQUEST_METHOD}" matchType="Pattern" pattern="^GET$" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
    <!-- 静态文件缓存：HTML 不缓存（保证更新立即生效），其它资源缓存 7 天 -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
      <!-- ACME HTTP-01 验证：无扩展名文件（token）必须以 text/plain 服务 -->
      <mimeMap fileExtension="." mimeType="text/plain" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>